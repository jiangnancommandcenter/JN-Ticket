rules_version = '2';

// =============================================================
//  CCTV Command Center — Firestore Security Rules (skeleton)
//  Project: jn-data-f29ae
//
//  ⚠️ IMPORTANT
//  These rules mirror what the current app code DOES today, so
//  deploying them must NOT break any existing flow. A few rules
//  are still intentionally open — see the per-rule TODO comments,
//  and do not close one without checking what depends on it.
//
//  WHAT CHANGED MOST RECENTLY: ticket creation is no longer open.
//  It was `if true` because submit-ticket.html filed tickets without a
//  login. That form now lives in the Area Manager dashboard
//  (js/owner-ticket-form.js), so the filer always has a session and
//  the rule is `isSignedIn()`.
//
//  ⚠️ submit-ticket.html STILL EXISTS and is still publicly reachable.
//  It is the login-free STATUS portal: a requester checking their own
//  ticket has no account, so the READ rule and the `?track=` flow are
//  unchanged and must not be "tidied" into an auth-only rule. Only the
//  submission form and the manual Track button were removed from it.
//
//  Test before deploying:
//    firebase emulators:exec --only firestore "firebase emulators:exec --only firestore --timeout 5m"
//    firebase deploy --only firestore:rules
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- Helpers ----------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Email/password sign-in exposes the user's email on the auth token.
    function selfEmail() {
      return request.auth.token.email.lower();
    }

    // The user's role lives on their own profile doc: users/<email>.
    // isSuperAdmin() reads that doc inside the rules engine, so no custom
    // claims are required. (Self-read of users/<email> is allowed below.)
    function isSuperAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(selfEmail())).data.role == 'superadmin';
    }

    // Violation reports are operator + superadmin only. Owners (and anyone
    // else) can never read or write them — this keeps CCTV violation data
    // off the Owner Dashboard even if a future owner client queries it.
    function isOperatorOrSuperAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(selfEmail())).data.role in ['operator', 'superadmin'];
    }

    // ---------------- chat roles: 1:1 CONVERSATIONS vs THE GROUP ROOM ----
    //
    // ⚠️⚠️ THESE ARE TWO DIFFERENT SETS. DO NOT MERGE THEM.
    //
    // isChatRole() is who may hold a 1:1 conversation: HR, superadmin, and the
    // Area Manager (stored role 'owner'). It authorises ROOM MEMBERSHIP, so
    // widening it only ever grants access to a room the person is listed in.
    //
    // isHrOrSuperAdmin() is who may be in the "All HR" GROUP chat. It is
    // deliberately still two roles, and the Area Manager is NOT one of them.
    //
    // WHY THEY MUST NOT BE THE SAME HELPER: isLegacyArchive() below is
    // `isHrOrSuperAdmin() && chatId == 'owner-superadmin'`, i.e. the group
    // room is gated on the ROLE because it has no `members` list. Adding
    // 'owner' to isHrOrSuperAdmin() would therefore have silently granted
    // every Area Manager READ AND WRITE on the All HR group chat — the exact
    // thing that role must not see. If you ever widen isChatRole(), check
    // isLegacyArchive() still names isHrOrSuperAdmin().
    function isChatRole() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(selfEmail())).data.role
          in ['hr', 'superadmin', 'owner'];
    }

    // HR <-> Superadmin ONLY. This is the "All HR" group chat's membership,
    // and an Area Manager is deliberately excluded even though it may hold 1:1
    // conversations with HR and with superadmins.
    function isHrOrSuperAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(selfEmail())).data.role in ['hr', 'superadmin'];
    }

    // The Area Manager (stored role 'owner'). Split out because the one place
    // it is needed — the `users` read clause that lets an Area Manager
    // discover the HR and superadmin accounts they may talk to — must NOT be
    // folded into the HR clause. HR keeps a strictly narrower reach
    // (superadmin docs only), so a shared clause would hand every HR the whole
    // HR + superadmin roster.
    function isAreaManager() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(selfEmail())).data.role == 'owner';
    }

    // HR alone (NOT superadmin — that case is already covered by
    // isOperatorOrSuperAdmin()). Used by the violations rule below to let HR
    // read the reports a superadmin explicitly transferred to them, and
    // nothing else. Unrelated to chat: an Area Manager has no violations access
    // at all and is not covered by this helper.
    function isHr() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(selfEmail())).data.role == 'hr';
    }

    // A violation report has been handed to HR by a superadmin. Reports with
    // no `hrStatus` field at all (i.e. every report filed before this feature
    // existed) simply do not match, so they stay operator/superadmin-only.
    function isTransferredToHr() {
      return resource.data.hrStatus == 'transferred';
    }

    // The room document for a given chat id. Used by the membership helpers
    // below, including from the SUBCOLLECTION rules — on a nested path
    // `resource` is the sub-document (a message, a presence doc), never the
    // room, so `resource.data.members` cannot be used there and the room has
    // to be fetched explicitly with get().
    function chatRoom(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId));
    }

    // True when the caller is listed in the room's `members` array.
    //
    // ⚠️ THIS IS THE RULE THAT MAKES 1:1 CONVERSATIONS PRIVATE. Before
    // per-person threads existed, the only room was shared and `members` was
    // never written, so `isHrOrSuperAdmin()` was sufficient: every HR and
    // every superadmin read the ONE shared room. The moment there is one
    // room per pair, a bare role check would let ANY HR read ANY OTHER HR's
    // private conversation. Membership, not role, is what authorises a read.
    //
    // ⚠️ `exists()` FIRST, OR EVERY BRAND-NEW CONVERSATION IS DENIED.
    // chat.js lets you open a thread with somebody you have never messaged,
    // and at that moment the room document DOES NOT EXIST YET. Calling
    // `get()` on a missing document raises an error inside the rules engine,
    // which evaluates the whole rule to DENIED — so picking the very first
    // person to write to would be refused, and (because chat.js reacts to a
    // permission error by disabling the launcher) the chat circle would grey
    // itself out with "blocked by the current Firestore rules". `exists()`
    // short-circuits to a clean false instead of an error.
    // ⚠️ isChatRole(), NOT isHrOrSuperAdmin(): membership now includes the Area
    // Manager, who may hold a 1:1 thread with an HR or a superadmin. Widening
    // this is safe precisely because it is still gated on `members` below — an
    // Area Manager gains nothing but the rooms they are actually listed in.
    function isChatMember(chatId) {
      return isChatRole() &&
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        selfEmail() in chatRoom(chatId).data.members;
    }

    // The LEGACY room, which is now the ALL HR GROUP CHAT. It predates
    // `members`, so membership cannot be evaluated against it — there is no
    // member list to read. That is exactly why it is the right room for a
    // group: access is gated on the ROLE (`isHrOrSuperAdmin()`), so a
    // brand-new HR or superadmin account is IN the conversation from the
    // moment its role is set, with nothing to invite and no list that can go
    // stale (a room update could not add anybody anyway).
    //
    // It is still never UPDATED: the group chat needs no preview (its row is
    // pinned), and freezing room documents is what keeps a shared room from
    // quietly turning into something else. Messages are the one thing written
    // here — see the messages block.
    //
    // ⚠️⚠️ isHrOrSuperAdmin() HERE, AND IT MUST NOT BECOME isChatRole().
    // This is the ONLY thing keeping the Area Manager out of the All HR group
    // chat. An Area Manager is a full chat participant (isChatRole) and can
    // hold 1:1 threads with HR and superadmins — but the group room is gated
    // on ROLE, not membership, so a single wrong helper name here exposes every
    // HR's messages in the group to every Area Manager. See the note above
    // isChatRole().
    function isLegacyArchive(chatId) {
      return isHrOrSuperAdmin() && chatId == 'owner-superadmin';
    }

    // Read access to a room: a member, OR the legacy archive.
    function canReadChat(chatId) {
      return isChatMember(chatId) || isLegacyArchive(chatId);
    }

    // ⚠️ Typing indicators now work in the GROUP chat as well as in 1:1.
    //
    // Presence is a per-room write, so it used to be gated on `isChatMember`
    // — which can never be true in the legacy group room, because that room is
    // ROLE-gated and has no `members` array to read. The result was that typing
    // indicators worked for everyone EXCEPT the "All HR" group, where the client
    // skipped them entirely (see publishPresence / startTypingListener in
    // chat.js). `isLegacyArchive(chatId)` already means "this is that one room,
    // AND the caller is HR or superadmin", so adding it here grants exactly the
    // right people exactly the right room.
    //
    // ⚠️ IT DOES NOT WEAKEN 1:1 PRIVACY. For any private conversation
    // `isLegacyArchive` is false (it requires chatId == 'owner-superadmin'), so
    // `isChatMember` still has to hold — an HR still cannot broadcast a typing
    // indicator into somebody else's private thread. Every rule using this
    // helper still requires `email == selfEmail()`, so a person may only ever
    // write, update or delete their OWN presence doc.
    function canPublishPresence(chatId) {
      return isChatMember(chatId) || isLegacyArchive(chatId);
    }

    // ---------------- branches ----------------
    // Public read: the submit-ticket form and both dashboards show the list.
    // Only superadmins add/delete branches; any signed-in user may push the
    // currentStatus update that happens when a status log is recorded.

    match /branches/{branchId} {
      allow read: if true;
      allow create: if isSuperAdmin();
      allow update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // ---------------- status_logs ----------------
    // Operators and superadmins record status; only superadmins edit/delete.

    match /status_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // ---------------- tickets ----------------

    match /tickets/{ticketId} {
      // ⚠️ TICKET CREATION IS NOW AUTHENTICATED. This used to be
      // `allow create: if true`, which existed for ONE reason: the submission
      // form lived on the public submit-ticket.html and anyone could file a
      // ticket. That form has moved into the Area Manager dashboard
      // (js/owner-ticket-form.js), where the filer is always signed in.
      //
      // The only client that writes a ticket now requires a session, so the
      // rule can say so. This is a real security improvement, not a formality:
      // with `if true`, anyone on the internet could write unlimited documents
      // into the tickets collection and drive up the Cloudinary bill.
      //
      // Restricting branches is NOT done here. A rule can only see the signed-in
      // user's OWN users/<email> doc, and that doc lists their branches — but
      // the doc's `branches` array is a claim, and enforcing it properly means
      // checking the submitted branch against it. The dashboard restricts the
      // dropdown to assigned branches, and that is a UI convenience; the write
      // itself is authenticated and audit-stamped (filedByUid / filedByEmail),
      // which is what this rule guarantees. Tightening to the branch set is the
      // obvious next step and is deliberately left as a visible TODO rather than
      // half-done.
      //
      // TODO (security): check request.resource.data.branch against the
      // filer's assigned branches once that list is trustworthy server-side.
      allow create: if isSignedIn();

      // Signed-in users (operators / superadmins / owners) read all tickets.
      // Public "Track Ticket Status" lookup reads ONLY approved tickets.
      // ⚠️ The read rule stays open on purpose: the Track modal is LOGIN-FREE,
      // because a requester checking their own ticket is not an employee and
      // has no account. It still requires an exact ticket-number match plus a
      // matching contact, which the rules cannot see — that two-factor check is
      // client-side, so this rule is the second lock, not the only one.
      allow read: if isSignedIn() || resource.data.approvalStatus == 'approved';

      // TODO (security): the public "Request Additional Footage" flow
      // updates a ticket without a login, so update is currently open to
      // match the app. Prefer a rate-limited Cloud Function + per-ticket
      // share token so anonymous users cannot mutate arbitrary tickets.
      allow update: if true;

      allow delete: if isSuperAdmin();
    }

    // ---------------- violations ----------------
    // CCTV violation reports (no ticket/request needed). Visible to
    // operators and superadmins — never to owners. Reports become visible
    // to everyone in that group immediately (no approval flow).
    // Operators may update/delete ONLY their own reports; superadmins may
    // update/delete any.
    //
    // HR READS transferred reports ONLY. A superadmin reviews each report and
    // hands the ones worth an incident report to HR, which sets
    // `hrStatus: 'transferred'`. HR then sees exactly those and nothing else —
    // the raw operator feed stays private. The write rules below are
    // untouched by this, so HR can still never modify or delete a report.
    //
    // ⚠️ Because this is a per-document check on `resource`, an HR QUERY must
    // prove it: the client has to filter with
    // `where('hrStatus', '==', 'transferred')` (see listenTransferredViolations
    // in firebase.js). An unfiltered HR query is correctly DENIED by these
    // rules — that is the guarantee working, not a bug.

    match /violations/{violationId} {
      function isOwnViolation() {
        return isSignedIn()
          && resource.data.reportedBy == request.auth.token.email.lower();
      }

      allow read: if isOperatorOrSuperAdmin() || (isHr() && isTransferredToHr());
      allow create: if isOperatorOrSuperAdmin();
      // Display rename only (REPORTS DATABASE): any signed-in operator or
      // superadmin may rename a file (attachments[].name) or the report folder
      // (subject). The changed keys must be a subset of these three fields, so
      // this can never be abused to edit or delete someone else's report.
      allow update: if isOperatorOrSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['attachments', 'subject', 'updatedAt']);
      allow update, delete: if isSuperAdmin() || (isOperatorOrSuperAdmin() && isOwnViolation());
    }

    // ---------------- chats ----------------
    // ONE ROOM PER PAIR. chat.js derives a deterministic id from the two
    // participants' emails (dm_<emailKey>__<emailKey>, sorted), so both
    // sides compute the same room id without a lookup and the `members`
    // array is what actually authorises access to it.
    //
    // Owners and operators are denied both reads and writes, so the threads
    // are invisible to them at the rules level (not just hidden in the UI).
    //
    // ⚠️ Read access is MEMBERSHIP (`canReadChat`), not role. A bare
    // `isHrOrSuperAdmin()` here would let any HR read any other HR's
    // private thread the moment per-person rooms exist.

    match /chats/{chatId} {
      // ⚠️ THE THIRD CLAUSE EXISTS SO THE CONVERSATION-LIST QUERY WORKS.
      //
      //   chat.js lists conversations with ONE query:
      //     chats where members array-contains <me>
      //   A query is authorised as a SINGLE rules evaluation over the whole
      //   collection: the engine must be able to prove the rule for every
      //   document the query could return. canReadChat() resolves each room
      //   with exists()/get(), which cannot be proven that way, so the whole
      //   query is REFUSED ("Missing or insufficient permissions") even though
      //   every room document is individually readable.
      //
      //   The symptom is not cosmetic: chat.js decides whether to open a
      //   thread by finding the room in that list, so a denied query means no
      //   conversation ever shows its history, no unread badge ever lights up,
      //   and (because the room is created on the first message) a brand-new
      //   thread cannot even be told apart from an existing one.
      //
      //   This clause states the SAME membership test through `resource`: on a
      //   document read `resource` IS the room, so
      //   `selfEmail() in resource.data.members` is exactly what
      //   isChatMember() computes with get(). It grants NOTHING new to a direct
      //   read — a room that does not list you is still refused by this clause
      //   AND by isChatMember() — but Firestore can now prove it from the
      //   query's own `array-contains` filter, so the list is authorised.
      //
      //   The `'members' in resource.data` guard is required: without it, a
      //   room with no member list (the legacy archive) would raise an error
      //   inside the rules engine, which evaluates the whole rule to DENIED.
      //
      //   ⚠️ isChatRole() in this second clause, so the conversation-list QUERY
      //   is provable for an Area Manager too. Without it they could open a
      //   single thread but the LIST query would be refused, and the list is
      //   what finds their conversations at all.
      // ⚠️ READ IS MEMBERSHIP, NOT ROLE — AND THAT MUST STAY THAT WAY.
// The reset tool does NOT need a superadmin read here, because Firestore has no
// "delete this collection" primitive: the ids are COMPUTED instead (room ids are
// deterministic — `dm_` + the two sorted URL-encoded emails joined by `__`, see
// dmRoomIdFor in chat.js — and the reset derives every candidate pair from the
// `users` collection, which a superadmin already reads). `allow delete` does
// not reference `resource`, so a delete is authorised without ever reading the
// document. That is what lets the chats be wiped with this rule UNCHANGED.
//
// An earlier version of this grant added `isSuperAdmin() ||` here so the tool
// could LIST the rooms. It worked, and it was wrong: a room doc carries
// `lastMessage`, so the grant exposed the final line of every private 1:1
// conversation to any superadmin — exactly what this rule exists to prevent.
// test/chat-rules.test.js caught it.
allow read: if canReadChat(chatId)
        || (isChatRole() && 'members' in resource.data
            && selfEmail() in resource.data.members);

      // CREATE must be checked separately from UPDATE. On a create the
      // document does not exist yet, so `resource` is null and
      // `resource.data` is null — dereferencing it inside diff() makes
      // the whole rule fail. Use request.resource.data.keys() instead.
      //
      // This is the write that creates the room on the very first
      // message. chat.js commits the room document FIRST, on its own, and
      // only then writes the message — because a message sent in the same
      // batch as the room it belongs to is DENIED (the message rule resolves
      // membership by reading that room, which does not exist yet at that
      // point). So a rejection here means the room never comes into being,
      // the message can never be written either, and every retry fails the
      // same way.
      //
      // ⚠️ `members` is REQUIRED on create and must contain the caller.
      // A room that did not list its creator could never be read back by
      // them, and a room that listed somebody else would be a way to open a
      // thread in another person's name. The legacy archive is explicitly
      // NOT writable, so this cannot resurrect it as a shared room.
      //
      // ⚠️ THE FIELD LIST IS UNCHANGED FROM THE PRE-1:1 RULES ON PURPOSE
      // (`type, title, lastMessage, lastMessageAt, lastSenderEmail,
      // members`). chat.js writes exactly these keys and nothing else, so
      // this rule is compatible with what is ALREADY deployed and the
      // conversation list works without a rules deploy. Do NOT add a field
      // here casually: the room is written BEFORE the message, so an unknown
      // key denies the room create, the room never exists, and the message
      // that follows it is denied too — sending would silently stop working.
      allow create: if isChatRole()
        && !isLegacyArchive(chatId)
        && request.resource.data.keys().hasOnly(
             ['type', 'title', 'lastMessage', 'lastMessageAt', 'lastSenderEmail', 'members'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && selfEmail() in request.resource.data.members;

      // UPDATE may reference resource.data, because the doc exists here.
      //
      // ⚠️ `members` is frozen: an update may change the summary but never
      // who the room belongs to. Otherwise either participant could add a
      // third person to a 1:1 thread (or drop themselves) and take over
      // its history.
      allow update: if isChatMember(chatId)
        && !isLegacyArchive(chatId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['type', 'title', 'lastMessage', 'lastMessageAt', 'lastSenderEmail']);

      // Nothing is deleted by anyone in the app: removing a room would orphan
      // its messages, which Firestore does NOT cascade — the room doc goes and
      // the whole thread stays behind as unreachable garbage.
      //
      // ⚠️ SUPERADMIN DELETE — FOR THE RESET TOOL ONLY (docs/reset.html).
      // This was `if false` because a room is meant to be permanent. A
      // superadmin is the whole app's trust anchor (isSuperAdmin() gates branch
      // creation, ticket deletion and user deletion already), so one more
      // superadmin-gated delete does not widen the blast radius of a compromised
      // superadmin by a meaningful amount.
      //
      // ⚠️ THE SUBCOLLECTIONS ARE DELIBERATELY NOT DELETABLE. messages/presence/
      // reactions/readReceipts/profiles all stay locked to their existing rules,
      // so this grant CANNOT be used to read or delete anything inside a private
      // 1:1 thread — only the room doc. Deleting the room makes every subcollection
      // unreachable (the conversation list queries `chats`), which is what makes
      // it a full chat wipe without a single privacy regression.
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if canReadChat(chatId);
        // A sender may only ever write their OWN message, and the
        // senderEmail must match the authenticated account — nobody can
        // post as somebody else.
        allow create: if isChatMember(chatId)
          && request.resource.data.senderEmail == selfEmail();
        // ⚠️ THE GROUP CHAT LIVES HERE, so the legacy room needs a message
        // write of its own. `isLegacyArchive` already means "is an HR or a
        // superadmin", which is precisely the membership of a group channel —
        // so this grants nothing to an owner or an operator, and the same
        // "you may only post as yourself" check still applies.
        //
        // ⚠️ REMOVING THIS WOULD SILENTLY BREAK THE GROUP CHAT ON THE NEXT
        // DEPLOY: the pinned "All HR" row would still be there, and every
        // message in it would be refused. Only MESSAGES are allowed — the
        // room document itself is still frozen (see isLegacyArchive).
        allow create: if isLegacyArchive(chatId)
          && request.resource.data.senderEmail == selfEmail();
        // Messages are immutable once sent; a sent message is never
        // edited or deleted.
        allow update, delete: if false;
      }

      // ---------------- chats/{chatId}/presence ----------------
      // Typing indicators. One doc per person holding just `at` (the
      // last time they were typing). Same create/update-vs-resource.data
      // trap as the room doc above: on a create the doc does not exist
      // yet, so only `update` may reference resource.data.

      match /presence/{userKey} {
        allow read: if canReadChat(chatId);

        // ⚠️ canPublishPresence (NOT isChatMember) so the ROLE-gated group room
        // works too — see the helper's note above. `email == selfEmail()` is
        // unchanged, so this still means "your own presence only".
        allow create: if canPublishPresence(chatId)
          && request.resource.data.email == selfEmail();

        allow update: if canPublishPresence(chatId)
          && resource.data.email == selfEmail();

        // Withdrawing a typing indicator deletes the doc, so the delete
        // must be restricted to the owner of that presence record.
        allow delete: if canPublishPresence(chatId)
          && resource.data.email == selfEmail();
      }

      // ---------------- chats/{chatId}/readReceipts ----------------
      // Per-person "I have read up to here" marker, used for the ✓ Sent /
      // ✓✓ Seen ticks on your own messages. ONE doc per person holding
      // just `lastReadAt`.
      //
      // This lives in its own subcollection rather than as a field on each
      // message because messages are deliberately IMMUTABLE
      // (`allow update, delete: if false` above) — stamping a per-message
      // `seen` flag would force that rule open and let anyone edit text
      // that was already sent. A single timestamp per person also means a
      // 200-message thread costs 2 writes, not 200.
      //
      // Same create/update-vs-resource.data trap as above: on a create the
      // doc does not exist yet, so only `update` may reference
      // resource.data.

      match /readReceipts/{userKey} {
        // Readable by the whole room so each person can see who has read
        // their messages (this is what turns a tick blue).
        allow read: if canReadChat(chatId);

        // A person may only ever write their OWN receipt — nobody can
        // mark somebody else's messages as read.
        allow create: if isChatMember(chatId)
          && request.resource.data.keys().hasOnly(['email', 'lastReadAt'])
          && request.resource.data.email == selfEmail();

        allow update: if isChatMember(chatId)
          && resource.data.email == selfEmail()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['email', 'lastReadAt']);

        allow delete: if isChatMember(chatId)
          && resource.data.email == selfEmail();
      }

      // ---------------- chats/{chatId}/profiles ----------------
      // Optional display name + job title, so a long thread can show
      // "Maria — HR Manager" instead of an email address. ONE doc per
      // person, holding only what that person chose to publish about
      // themselves.
      //
      // This is deliberately NOT the `users` collection: `users/{email}`
      // is readable only by a superadmin or the profile owner, so an HR
      // member could not read a colleague's profile and every name would
      // silently fall back to the email prefix. The chat keeps its own
      // roster, readable by the thread and writable ONLY by its owner.
      //
      // It carries no permissions and no account data — a display name
      // and a job title cannot grant access to anything.

      match /profiles/{userKey} {
        // Readable by the whole chat team. This subcollection doubles as the
        // PEOPLE DIRECTORY for the conversation list: `users/{email}` is
        // readable only by a superadmin or the profile owner, so an HR
        // member could not otherwise discover who the other HRs are.
        //
        // Reusing it (rather than adding a new `chatProfiles` collection)
        // is deliberate: this rule is ALREADY deployed, so the conversation
        // list works without a rules deploy.
        allow read: if isChatRole();

        // A person may only ever write their OWN profile, and only into a
        // room they belong to.
        allow create: if isChatRole()
          && request.resource.data.keys()
               .hasOnly(['email', 'role', 'displayName', 'title'])
          && request.resource.data.email == selfEmail();

        allow update: if isChatRole()
          && resource.data.email == selfEmail()
          && request.resource.data.keys()
               .hasOnly(['email', 'role', 'displayName', 'title'])
          && request.resource.data.email == selfEmail();

        allow delete: if isChatRole()
          && resource.data.email == selfEmail();
      }

      // ---------------- chats/{chatId}/reactions ----------------
      // Emoji reactions, e.g. { messageId }__thumbsup.
      //
      // SIBLING of `messages`, not nested under it, so the whole thread's
      // reactions can be read with ONE onSnapshot on a single collection.
      // A subcollection of a query is not directly subscribable, so nesting
      // would have forced a collectionGroup query and a composite index.
      //
      // A REACTION IS IMMUTABLE, like the message it points at: toggling is
      // a delete + a create, never an update. That keeps the history of a
      // thread's reactions exactly as auditable as the messages themselves.

      match /reactions/{reactionId} {
        allow read: if canReadChat(chatId);

        // A person may only ever react AS THEMSELVES.
        allow create: if isChatMember(chatId)
          && request.resource.data.keys().hasOnly(['messageId', 'emoji', 'email'])
          && request.resource.data.email == selfEmail()
          && request.resource.data.messageId is string
          && request.resource.data.emoji is string;

        // No update: a changed reaction is a different doc.
        // (Superseded: ONE reaction per person per message is now enforced by
        //  keying the doc on {messageId}__{emailKey}, so switching emoji is
        //  an update of the `emoji` field only. The rule below permits exactly
        //  that and nothing else: `messageId` and `email` are frozen, so a
        //  reaction can never be repointed at another message or person.)
        allow update: if isChatMember(chatId)
          && resource.data.email == selfEmail()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emoji'])
          && request.resource.data.keys().hasOnly(['messageId', 'emoji', 'email']);

        // You may only remove your OWN reaction.
        allow delete: if isChatMember(chatId)
          && resource.data.email == selfEmail();
      }
    }

    // ---------------- counters ----------------
    // Per-branch ticket numbering (`counters/tickets-<prefix>`) is
    // transactionally incremented by the public ticket form.

    match /counters/{counterId} {
      // The counter is incremented by generateTicketNumber() (firebase.js),
      // which only the signed-in ticket form calls now that the public form is
      // gone. The write is still open because a transaction reads the counter
      // before incrementing it, and an authenticated-only rule would need to
      // be duplicated for read and write to stay honest.
      //
      // TODO (security): split this to `if (isSignedIn())` once the read side
      // can be moved behind a Cloud Function. While it is open, an anonymous
      // caller could inflate a branch's counter and cause a ticket-number gap.
      allow read, write: if true;
    }

    // ---------------- users ----------------
    // users/<email> is the profile document created during registration
    // (role 'owner', status 'pending') and later approved by a superadmin.

    match /users/{userId} {
      function isSelf() {
        return isSignedIn() && userId == selfEmail();
      }

      // Registration creates ONLY the requester's own profile and only in
      // the 'pending' owner state — a normal user can never self-register
      // as anything but a pending owner.
      allow create: if isSelf()
        && request.resource.data.role == 'owner'
        && request.resource.data.status == 'pending';

      allow read: if isSuperAdmin() || isSelf();

      // THE CHAT'S CONVERSATION LIST, second half: an HR may only discover
      // the SUPERADMIN accounts — exactly the people an HR may start a
      // thread with (isStartable() in js/chat.js). A superadmin reads the
      // whole collection through the statement above, so nothing changes
      // for them, and this is what puts a brand-new superadmin (or a brand
      // -new HR, from the other direction) on the roster the moment it is
      // registered rather than the moment its owner opens the chat.
      //
      // ⚠️ NARROW ON PURPOSE, AND IT MUST STAY NARROW. The condition is
      // per-document, and Firestore proves it only for a query filtered the
      // same way — so the HR's client asks with
      // `users.where('role', '==', 'superadmin')`, and an UNFILTERED HR read
      // of `users` cannot be proven and is denied. That is what keeps owner
      // and operator accounts, their statuses and their permissions out of
      // an HR's reach while still listing every account an HR may message.
      //
      // ⚠️ THE EQUALITY CANNOT MISS ANYBODY. Chat access itself is granted
      // by `role in ['hr', 'superadmin']` in isHrOrSuperAdmin() — a
      // case-sensitive test — so an account that is allowed to chat at all
      // already stores the lowercase value. (The superadmin's whole-collection
      // read deliberately has no filter, so a role stored as 'HR ' still
      // counts there.)
      allow read: if isHrOrSuperAdmin()
        && resource.data.role == 'superadmin';

      // THE CONVERSATION LIST, third statement: an AREA MANAGER may discover
      // the HR **and** superadmin accounts — the two roles they are allowed to
      // start a thread with (isStartable() in js/chat.js). This is what puts a
      // brand-new HR or superadmin on an Area Manager's list the moment it is
      // registered, rather than the moment its owner opens the chat.
      //
      // ⚠️ DELIBERATELY NOT MERGED WITH THE HR CLAUSE ABOVE. HR reads ONLY
      // superadmin docs; the Area Manager reads two roles. A shared clause
      // would have to be the union, which would silently widen every HR's reach
      // to the whole HR roster — and HRs are not allowed to message each other.
      //
      // ⚠️ NARROW ON PURPOSE, AND IT MUST STAY NARROW: this is per-document, so
      // Firestore proves it only for a query filtered the same way. The client
      // asks with `users.where('role', 'in', ['hr', 'superadmin'])`, and an
      // UNFILTERED Area Manager read cannot be proven and is denied. That is
      // what keeps every OTHER Area Manager's account — their status and their
      // branch assignments — out of an Area Manager's reach, so two managers
      // can never see or reach each other.
      allow read: if isAreaManager()
        && resource.data.role in ['hr', 'superadmin'];

      // Superadmins may edit anything (approvals). Self-edits are allowed
      // but can never touch role/status/permissions (no privilege escalation).
      allow update: if isSuperAdmin()
        || (isSelf() && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'status', 'permissions']));

      allow delete: if isSuperAdmin();
    }

    // ---------------- catch-all: deny everything else ----------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}